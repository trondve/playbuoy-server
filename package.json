{
  "name": "playbuoy-server",
  "version": "1.0.0",
  "description": "Database server & API for PlayBuoy IoT buoys",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "lint": "eslint src --fix",
    "migrate": "node tools/scripts/migrate.js",
    "migrate:rollback": "node tools/scripts/migrate-rollback.js",
    "db:shell": "psql",
    "seed": "node tools/scripts/seed.js"
  },
  "keywords": [
    "iot",
    "buoy",
    "water-monitoring",
    "timeseries",
    "api"
  ],
  "author": "PlayBuoy Team",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "pg": "^8.10.0",
    "dotenv": "^16.3.1",
    "joi": "^17.11.0",
    "pino": "^8.16.2",
    "pino-http": "^8.5.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "jest": "^29.7.0",
    "supertest": "^6.3.3",
    "eslint": "^8.52.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
